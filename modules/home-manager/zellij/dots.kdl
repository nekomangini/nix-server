layout {

	cwd "/home/nekomangini/nix-server"

    default_tab_template {
        // NOTE: the default zellij tab-bar and status bar plugins
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        // NOTE: shows hint
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="explorer" {
		pane command="yazi"
    }
    tab name="editor" {
pane command="hx"
    }
    tab name="git" {
		pane command="lazygit"
    }
    tab name="terminal"
}
